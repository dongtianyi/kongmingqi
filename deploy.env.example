# 孔明棋部署配置示例
# 复制此文件为 deploy.env 并填入实际配置
# cp deploy.env.example deploy.env

# 服务器配置（与 ggg_web 项目共用同一台服务器）
export DEPLOY_HOST="121.41.84.160"
export DEPLOY_USER="root"
export DEPLOY_PORT="22"
export DEPLOY_KEY=""  # SSH 密钥文件路径，如 ~/.ssh/id_rsa 或 ~/path/to/key.pem

# 部署路径配置
# 随机字符串用于隐藏访问，只有知道链接的人才能访问
# 建议使用格式: kmq-xxxxxxxx (8位随机字母数字)
export DEPLOY_PATH="kmq-x7k9m2p4"

# 部署目录（自动根据 DEPLOY_PATH 生成）
export DEPLOY_DIR="/var/www/kongmingqi-${DEPLOY_PATH}"

# 最终访问地址
# https://www.beinanguo.com/${DEPLOY_PATH}/
# 例如: https://www.beinanguo.com/kmq-x7k9m2p4/

# ==================== 部署流程 ====================
# 1. 复制配置文件: cp deploy.env.example deploy.env
# 2. 编辑配置: vi deploy.env (设置 SSH 密钥路径和部署路径)
# 3. 检查配置: make deploy-check
# 4. 执行部署: make deploy
# 5. 查看 nginx 配置: make nginx-conf
# 6. 首次部署需要手动添加 nginx 配置，然后重启 nginx
