# 孔明棋部署配置
# 与 ggg_web 共用服务器和 nginx

# 服务器配置（与 ggg_web 相同）
export DEPLOY_HOST="121.41.84.160"
export DEPLOY_USER="root"
export DEPLOY_PORT="22"
export DEPLOY_KEY=""  # SSH 密钥文件路径，如 ~/.ssh/id_rsa

# 部署目录配置
# 随机路径前缀，用于隐藏访问
export DEPLOY_PATH="kmq-x7k9m2p4"  # 修改为你想要的随机字符串
export DEPLOY_DIR="/var/www/${DEPLOY_PATH}"

# 访问地址：https://www.beinanguo.com/${DEPLOY_PATH}/
